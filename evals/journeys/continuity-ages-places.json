{
  "id": "continuity-ages-places",
  "title": "Find an age and a place that contradict across scenes",
  "guarantee": "Claims proposed with an attribute let inspect_continuity report a duration that shrinks with story time and a building on two banks, each citing both literal quotes with other readings; a rumor that disagrees with a narrated fact is not reported.",
  "book": {
    "id": "orilla",
    "title": "La orilla",
    "scenes": [
      "evals/journeys/books/continuidad/001-la-orilla.md",
      "evals/journeys/books/continuidad/002-la-crecida.md"
    ]
  },
  "steps": [
    {
      "id": "propose",
      "do": "call",
      "tool": "propose_claims",
      "args": {
        "book": "orilla",
        "extractor": "scripted-agent",
        "candidates": [
          {
            "statement": "Elena has guarded the bridge for eleven years.",
            "subject": "Elena",
            "source_file": "scenes/001-la-orilla.md",
            "quote": "Elena llevaba once años custodiando el puente",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 1,
            "attribute": {
              "name": "años_en",
              "value": "once",
              "about": "puente"
            }
          },
          {
            "statement": "The tavern says Elena has been on the bridge for under five years.",
            "subject": "Elena",
            "source_file": "scenes/001-la-orilla.md",
            "quote": "Elena no llevaba ni cinco años en el puente",
            "scope": "book",
            "epistemic_kind": "rumor",
            "story_time": 1,
            "attribute": {
              "name": "años_en",
              "value": "cinco",
              "about": "puente"
            }
          },
          {
            "statement": "Elena has been on the bridge for nine years.",
            "subject": "Elena",
            "source_file": "scenes/002-la-crecida.md",
            "quote": "que llevaba nueve años en el puente",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 5,
            "attribute": {
              "name": "años_en",
              "value": 9,
              "about": "puente"
            }
          },
          {
            "statement": "The Casa del Peso stands on the Sal bank.",
            "subject": "Casa del Peso",
            "source_file": "scenes/001-la-orilla.md",
            "quote": "La Casa del Peso estaba en la orilla de Sal",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 1,
            "attribute": {
              "name": "lugar",
              "value": "orilla de Sal"
            }
          },
          {
            "statement": "The Casa del Peso stands in Ribera, across the river.",
            "subject": "Casa del Peso",
            "source_file": "scenes/002-la-crecida.md",
            "quote": "a la Casa del Peso, al otro lado del río",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 5,
            "attribute": {
              "name": "lugar",
              "value": "Ribera"
            }
          }
        ]
      },
      "checks": [
        {
          "name": "every claim is created",
          "path": "propose.data.created.length",
          "equals": 5
        },
        {
          "name": "nothing is rejected",
          "path": "propose.data.rejected",
          "equals": []
        }
      ]
    },
    {
      "id": "continuity",
      "do": "call",
      "tool": "inspect_continuity",
      "args": {
        "book": "orilla"
      },
      "checks": [
        {
          "name": "two problems are found, not the rumor",
          "path": "continuity.data.total",
          "equals": 2
        },
        {
          "name": "a shrinking duration and a building in two places",
          "path": "continuity.data.findings.*.kind",
          "equals": [
            "duration",
            "place"
          ]
        },
        {
          "name": "they are possible contradictions",
          "path": "continuity.data.findings.*.classification",
          "equals": [
            "possible_contradiction",
            "possible_contradiction"
          ]
        },
        {
          "name": "each cites two literal quotes",
          "path": "continuity.data.findings.*.citations.length",
          "equals": [
            2,
            2
          ]
        },
        {
          "name": "the duration finding says what contradicts what",
          "path": "continuity.data.findings.0.explanation",
          "matches": "11 años.*but later.*9 años"
        },
        {
          "name": "the place finding gives both places",
          "path": "continuity.data.findings.1.explanation",
          "matches": "orilla de Sal.*Ribera"
        },
        {
          "name": "other readings are offered",
          "path": "continuity.data.findings.0.alternatives",
          "contains": "unreliable_narrator: the narrator may be wrong, or not telling the truth"
        }
      ]
    }
  ]
}
