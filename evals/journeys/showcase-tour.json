      "args": {
        "book": "puerta",
        "findings": [
          {
            "question": "knowledge",
            "kind": "interpretation",
            "statement": "Elena names the altar slab before she learns it; scene 11 says she guessed, so the first contradiction is a lucky lie, not a slip.",
            "characters": [
              "Elena"
            ],
            "evidence": [
              {
                "file": "scenes/011-lo-que-dijo-elena.md",
                "quote": "No lo sabía —dijo Elena—. Lo dije para que callara."
