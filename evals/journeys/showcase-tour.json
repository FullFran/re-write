      ]
    },
    {
      "id": "near",
      "do": "call",
      "tool": "graph_neighbors",
      "args": {
        "book": "puerta",
        "node": "Elena"
      },
      "checks": [
        {
          "name": "Elena's neighbours include the man she defends",
          "path": "near.data.nodes.*.name",
          "contains": "Bruno"
        }
      ]
    },
    {
      "id": "path",
      "do": "call",
      "tool": "graph_path",
      "args": {
        "book": "puerta",
        "from": "Marcos Ferrer",
        "to": "Padre Damián"
      },
      "checks": [
        {
          "name": "two people who never share a scene are joined through Anselmo",
          "path": "path.data.path.*.name",
          "equals": [
            "Marcos Ferrer",
            "Anselmo",
            "Padre Damián"
          ]
        }
      ]
    },
    {
      "id": "central",
      "do": "call",
      "tool": "graph_central",
      "args": {
        "book": "puerta",
        "metric": "betweenness"
      },
      "checks": [
        {
          "name": "the story passes through Elena",
          "path": "central.data.ranking.0.name",
          "equals": "Elena"
        }
      ]
    },
    {
      "id": "orphans",
      "do": "call",
      "tool": "graph_orphans",
      "args": {
        "book": "puerta"
      },
      "checks": [
        {
          "name": "the note nothing links is the orphan",
          "path": "orphans.data.orphans.*.name",
          "equals": [
            "Salina Vieja"
          ]
        }
      ]
    },
    {
      "id": "claims",
      "do": "call",
      "tool": "propose_claims",
      "args": {
        "book": "puerta",
        "extractor": "scripted-agent",
        "candidates": [
          {
            "statement": "Elena states that the key lies under the altar slab.",
            "subject": "Elena",
            "source_file": "scenes/001-la-puerta-de-sal.md",
            "quote": "La llave está bajo la losa del altar",
            "scope": "book",
            "epistemic_kind": "belief",
            "story_time": 1,
            "reveal_order": 3,
            "knowledge": {
              "holder": "Elena",
              "fact": "key-under-altar",
              "mode": "displays"
            }
          },
          {
            "statement": "Elena knew nothing about the hiding place before that night.",
            "subject": "Elena",
            "source_file": "scenes/002-el-altar.md",
            "quote": "Elena, que hasta esa noche no había sabido nada del escondite",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 4,
            "reveal_order": 5,
            "knowledge": {
              "holder": "Elena",
              "fact": "key-under-altar",
              "mode": "acquires"
            }
          },
          {
            "statement": "Tomás says the tax collector forged Bruno's signatures.",
            "subject": "Anselmo",
            "source_file": "scenes/008-la-ronda-de-noche.md",
            "quote": "Las firmas del libro las puso él, el recaudador, con su mano.",
            "scope": "book",
            "epistemic_kind": "belief",
            "story_time": 9,
            "reveal_order": 13,
            "knowledge": {
              "holder": "Tomás",
              "fact": "ledger-forged",
              "mode": "displays"
            }
          },
          {
            "statement": "Tomás learns from Elena that Bruno's debts are forged.",
            "subject": "Anselmo",
            "source_file": "scenes/012-la-verguenza-de-tomas.md",
            "quote": "¿Las deudas de Bruno son falsas?",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 13,
            "reveal_order": 22,
            "knowledge": {
              "holder": "Tomás",
              "fact": "ledger-forged",
              "mode": "acquires"
            }
          },
          {
            "statement": "Elena finds Bruno alive in Ribera, hidden in Inés's hut.",
            "subject": "Bruno",
            "source_file": "scenes/014-la-otra-orilla.md",
            "quote": "con la barba de dos semanas y la cara flaca y pálida, estaba",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 14,
            "reveal_order": 26,
            "knowledge": {
              "holder": "Elena",
              "fact": "bruno-in-ribera",
              "mode": "acquires"
            }
          },
          {
            "statement": "Inés has hidden Bruno since the night he disappeared.",
            "subject": "Bruno",
            "source_file": "scenes/014-la-otra-orilla.md",
            "quote": "Inés lo había escondido desde la primera noche",
            "scope": "book",
            "epistemic_kind": "narrated_fact",
            "story_time": 0,
            "reveal_order": 27,
            "knowledge": {
              "holder": "Inés",
              "fact": "bruno-in-ribera",
              "mode": "acquires"
            }
          }
        ]
      },
      "checks": [
        {
          "name": "every claim quotes the text literally",
          "path": "claims.data.created.length",
          "equals": 6
        },
        {
          "name": "nothing is rejected",
