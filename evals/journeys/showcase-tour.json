{
  "id": "showcase-tour",
  "title": "Tour the showcase book: notes, the story graph, who knows what, continuity and a finding",
  "guarantee": "On a complete novel, notes reach the book only when a person accepts them; the graph answers paths, centrality and orphans from the links; who-knows-what edges keep the mystery hidden until its scene; the continuity check finds the planted knowledge-order problems; and a finding needs a literal quote.",
  "book": {
    "id": "puerta",
    "title": "La puerta de Sal",
    "scenes": [
      "fixtures/la-puerta-de-sal/scenes/001-la-puerta-de-sal.md",
      "fixtures/la-puerta-de-sal/scenes/002-el-altar.md",
      "fixtures/la-puerta-de-sal/scenes/003-la-taberna-del-ancla.md",
      "fixtures/la-puerta-de-sal/scenes/004-el-pano-seco.md",
      "fixtures/la-puerta-de-sal/scenes/005-la-barquera.md",
      "fixtures/la-puerta-de-sal/scenes/006-la-casa-del-peso.md",
      "fixtures/la-puerta-de-sal/scenes/007-el-senor-de-ribera.md",
      "fixtures/la-puerta-de-sal/scenes/008-la-ronda-de-noche.md",
      "fixtures/la-puerta-de-sal/scenes/009-tinta-nueva.md",
      "fixtures/la-puerta-de-sal/scenes/010-el-trato.md",
      "fixtures/la-puerta-de-sal/scenes/011-lo-que-dijo-elena.md",
      "fixtures/la-puerta-de-sal/scenes/012-la-verguenza-de-tomas.md",
      "fixtures/la-puerta-de-sal/scenes/013-antes-de-la-lluvia.md",
      "fixtures/la-puerta-de-sal/scenes/014-la-otra-orilla.md",
      "fixtures/la-puerta-de-sal/scenes/015-la-crecida.md",
      "fixtures/la-puerta-de-sal/scenes/016-la-capilla-vacia.md",
      "fixtures/la-puerta-de-sal/scenes/017-la-puerta.md",
      "fixtures/la-puerta-de-sal/scenes/018-el-libro-mojado.md",
      "fixtures/la-puerta-de-sal/scenes/019-la-medida-de-la-sal.md",
      "fixtures/la-puerta-de-sal/scenes/020-la-losa.md"
    ]
  },
  "steps": [
    {
      "id": "start",
      "do": "call",
      "tool": "list_notes",
      "args": {
        "book": "puerta"
      },
      "checks": [
        {
          "name": "the book starts without notes",
          "path": "start.data.notes",
          "equals": []
        },
        {
          "name": "links in the scenes name notes that do not exist yet, the planted one among them",
          "path": "start.data.unresolved.*.target",
          "contains": "Salinas del Norte"
        }
      ]
    },
    {
      "id": "elena",
      "do": "call",
      "tool": "propose_note",
      "args": {
        "book": "puerta",
        "name": "Elena",
        "text": "---\ntype: personaje\naliases: [la guardiana]\n---\nGuardiana del puente. Amiga de [[Bruno]].\n",
        "rationale": "Ficha del libro de muestra"
      },
      "checks": [
        {
          "name": "the note Elena is proposed",
          "path": "elena.data.created",
          "equals": true
        }
      ]
    },
    {
      "id": "accept_elena",
      "do": "person_reviews_proposal",
      "proposal_id": {
        "ref": "elena.data.proposal.proposal_id"
      },
      "decision": "accept",
      "checks": [
        {
          "name": "the person accepts Elena",
          "path": "accept_elena.status",
          "equals": "accepted"
        }
      ]
    },
    {
      "id": "bruno",
