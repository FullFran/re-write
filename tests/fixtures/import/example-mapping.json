{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Example mapping for importing chapters from a SQLite database into RE;write",
  "table": "chapters",
  "columns": {
    "order": "chapter_num",
    "title": "title",
    "body": "content",
    "format": "format"
  },
  "filter": "book_id = 1",
  "orderBy": "chapter_num ASC",
  "defaultFormat": "markdown"
}
