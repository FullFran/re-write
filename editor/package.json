{
  "name": "rewrite-scene-editor",
  "private": true,
  "description": "The review page's scene editor (CodeMirror 6), bundled into one ES module the server serves at /review/editor.js. Kept apart so the server and its unit tests add no dependency.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "esbuild": "0.28.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-metrics": "2.4.2",
    "graphology-shortest-path": "2.1.0",
    "graphology-types": "0.24.8",
    "sigma": "4.0.6"
  },
  "dependencies": {
    "@codemirror/search": "6.7.2"
  }
}
