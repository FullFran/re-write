{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcs:schema:hcs-0006:error:0.1",
  "title": "HCS error object",
  "description": "Typed error reported by an HCS host (HCS-0006).",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": { "$ref": "#/$defs/code" },
    "message": { "type": "string", "minLength": 1 },
    "entry": { "$ref": "urn:hcs:schema:hcs-0001:catalog-manifest:0.1#/$defs/packageId" },
    "capability": { "$ref": "urn:hcs:schema:hcs-0002:capability:0.1#/$defs/capabilityRef" },
    "requirement": { "type": "string", "pattern": "^HCS-[0-9]{4}-R[0-9]{3}$" },
    "details": {
      "type": "object",
      "propertyNames": { "$ref": "urn:hcs:schema:hcs-0000:common:0.1#/$defs/extensionName" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "code": {
      "enum": [
        "manifest_invalid",
        "unsupported_hcs_version",
        "duplicate_entry",
        "integrity_mismatch",
        "unsupported_contribution",
        "platform_incompatible",
        "missing_dependency",
        "version_incompatible",
        "ambiguous_provider",
        "dependency_cycle",
        "permission_denied",
        "unsupported_capability",
        "timeout",
        "plugin_failed",
        "signature_invalid",
        "rollback_rejected"
      ]
    },
    "jsonrpcErrorResponse": {
      "description": "JSON-RPC 2.0 error response carrying an HCS error in error.data.hcsError (HCS-0006-R003).",
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "integer", "null"] },
        "error": {
          "type": "object",
          "required": ["code", "message", "data"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "required": ["hcsError"],
              "properties": { "hcsError": { "$ref": "#" } }
            }
          }
        }
      }
    },
    "problemDetails": {
      "description": "RFC 9457 problem details object carrying an HCS error (HCS-0006-R004, R005). type/code equality is checked by the runner.",
      "type": "object",
      "required": ["type", "hcsError"],
      "properties": {
        "type": { "type": "string", "pattern": "^urn:hcs:error:[a-z_]+$" },
        "title": { "type": "string" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "hcsError": { "$ref": "#" }
      }
    }
  }
}
