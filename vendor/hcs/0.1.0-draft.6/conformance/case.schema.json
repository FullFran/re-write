{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcs:schema:conformance:case:0.1",
  "title": "HCS conformance case",
  "description": "One conformance case (HCS-0000 section 8). Polarity comes from the directory: valid/ satisfies the listed requirements, invalid/ violates them.",
  "type": "object",
  "required": ["description", "requirements", "level", "input", "expect"],
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^HCS-[0-9]{4}-R[0-9]{3}$" }
    },
    "level": { "enum": ["document", "integrity", "resolution", "authority", "distribution", "projection", "recovery", "client", "host"] },
    "target": { "type": "string", "description": "Schema URI the input is validated against (document level)." },
    "input": true,
    "expect": {
      "type": "object",
      "properties": {
        "outcome": { "enum": ["valid", "invalid"] },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": { "$ref": "urn:hcs:schema:hcs-0006:error:0.1#/$defs/code" },
              "entry": { "type": "string" },
              "capability": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "activationOrder": { "type": "array", "items": { "type": "string" } },
        "selected": { "type": "array", "items": { "type": "string" } },
        "signingInput": { "type": "string", "description": "Expected HCS-0007 signature input as UTF-8 text (distribution level)." },
        "decision": { "$ref": "urn:hcs:schema:hcs-0005:authority:0.1#/$defs/decision" },
        "hcsError": { "description": "HCS error a client extracts, or null when the response carries none (client level).", "oneOf": [{ "type": "null" }, { "$ref": "urn:hcs:schema:hcs-0006:error:0.1" }] },
        "action": { "enum": ["start", "health-check", "discard-pending", "return", "stop-and-report"], "description": "Action a host takes after a restart (recovery level)." },
        "generation": { "type": ["integer", "null"], "description": "Generation the action is about (recovery level)." },
        "returnTo": { "type": ["integer", "null"], "description": "Confirmed generation a failure returns to (recovery level)." },
        "retain": { "type": "array", "items": { "type": "integer" }, "description": "Generations a cleanup must keep (recovery level)." },
        "failed": { "type": "array", "items": { "type": "integer" }, "description": "Failed records a cleanup must keep (recovery level)." },
        "behaviour": { "type": "string", "description": "Expected host behaviour (host level)." }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "level": { "const": "document" } } }, "then": { "required": ["target"], "properties": { "expect": { "required": ["outcome"] } } } },
    { "if": { "properties": { "level": { "const": "integrity" } } }, "then": { "properties": { "expect": { "required": ["outcome"] } } } },
    { "if": { "properties": { "level": { "const": "resolution" } } }, "then": { "properties": { "expect": { "required": ["activationOrder", "errors"] } } } },
    { "if": { "properties": { "level": { "const": "authority" } } }, "then": { "properties": { "expect": { "required": ["decision"] } } } },
    { "if": { "properties": { "level": { "const": "distribution" } } }, "then": { "properties": { "expect": { "anyOf": [{ "required": ["outcome"] }, { "required": ["signingInput"] }] } } } },
    { "if": { "properties": { "level": { "const": "projection" } } }, "then": { "properties": { "expect": { "required": ["errors", "selected"] } } } },
    { "if": { "properties": { "level": { "const": "recovery" } } }, "then": { "properties": { "input": { "type": "object", "required": ["persisted"] }, "expect": { "required": ["action"] } } } },
    { "if": { "properties": { "level": { "const": "client" } } }, "then": { "properties": { "input": { "type": "object", "oneOf": [{ "required": ["problem"], "not": { "required": ["response"] } }, { "required": ["response"], "not": { "required": ["problem"] } }] }, "expect": { "required": ["hcsError"] } } } },
    { "if": { "properties": { "level": { "const": "host" } } }, "then": { "properties": { "expect": { "required": ["behaviour"] } } } }
  ]
}
